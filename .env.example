# Copy this file to `.env` and fill it in. `.env` is git-ignored — never commit secrets.

# --- MetaTrader 5 -----------------------------------------------------------
# Leave these blank to attach to whichever account the running MT5 terminal is
# already logged into (simplest and recommended for a demo account).
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Only needed if you have several MT5 installations:
# MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# --- Telegram ---------------------------------------------------------------
# 1. Message @BotFather -> /newbot -> copy the token below.
# 2. Message @userinfobot (or your own bot, then check
#    https://api.telegram.org/bot<TOKEN>/getUpdates) to get your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional ---------------------------------------------------------------
DISCORD_WEBHOOK_URL=
TWELVEDATA_API_KEY=
LOG_LEVEL=INFO
LOG_MAX_MB=10
LOG_BACKUP_COUNT=5
